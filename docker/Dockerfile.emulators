FROM node:22-trixie-slim

ARG FIREBASE_TOOLS_VERSION=15.36.0
ENV CI=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "firebase-tools@${FIREBASE_TOOLS_VERSION}"

WORKDIR /workspace
COPY firebase.docker.json firestore.rules ./
VOLUME ["/data", "/root/.cache/firebase/emulators"]
EXPOSE 9099 8080 4000
